{
  "name": "zy-labour-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "python3 server/app.py serve --dev",
    "check": "node scripts/check.mjs && node --check dist/shared.js && node --check dist/supabase-adapter.js",
    "test": "python3 -m unittest discover -s tests -v",
    "start:static": "python3 -m http.server 8080 --directory dist",
    "test:postgres": "node tests/postgres.mjs",
    "test:transport": "node tests/supabase-adapter.mjs && node --experimental-strip-types tests/edge-test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14"
  }
}
